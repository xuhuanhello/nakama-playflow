# Copy to your deployment's secret/configuration system, never commit real keys.
# Mandatory environment variables intentionally have no working defaults.
FLEET_DATABASE_URL=
FLEET_DEPLOYMENT_ID=
FLEET_PLAYFLOW_URL=https://api.computeflow.cloud/api
FLEET_PLAYFLOW_API_KEY=
FLEET_CONTROL_URL=https://nakama.example.com
FLEET_BUILD_HASH=
FLEET_REGION=
FLEET_COMPUTE_SIZE=
FLEET_PORT_NAME=game
FLEET_PROVIDER_VERSION=
FLEET_MAX_ROOMS=
FLEET_MIN_INSTANCES=0
FLEET_MAX_INSTANCES=1
FLEET_ADMIN_TOKEN=
FLEET_SIGNING_KEY=
FLEET_ALLOW_HTTP=false
FLEET_MODE=production
# Must cover maximum room lifetime, reconnect, and durable result flush margin.
# When PlayFlow reports a forced TTL, stop new rooms and begin drain this early.
FLEET_MIN_LIFETIME_FOR_ADMISSION_SECONDS=1800
FLEET_IDLE_SECONDS=600
FLEET_LAUNCH_TIMEOUT=120
FLEET_ALLOCATION_TIMEOUT=180
FLEET_PROVIDER_POLL_SECONDS=10
